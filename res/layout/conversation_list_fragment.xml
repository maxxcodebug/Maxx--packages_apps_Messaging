<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- MaxxOS header: search / title + subtitle / overflow, then filter chips -->
    <LinearLayout
        android:id="@+id/maxx_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/maxx_search_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/maxx_round_button_bg"
                android:src="@drawable/ic_maxx_search"
                android:tint="@color/maxx_icon"
                android:contentDescription="@string/maxx_search" />

            <LinearLayout
                android:id="@+id/maxx_title_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/maxx_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/maxx_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/maxx_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/maxx_subtitle"
                    android:textColor="@color/maxx_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/maxx_search_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="56dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/maxx_chip_container_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="@string/maxx_search_hint"
                android:textColor="@color/maxx_text_primary"
                android:textColorHint="@color/maxx_text_secondary"
                android:singleLine="true"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:inputType="text"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/maxx_more_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/maxx_round_button_bg"
                android:src="@drawable/ic_maxx_more"
                android:tint="@color/maxx_icon"
                android:contentDescription="@string/maxx_more_options" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/maxx_chip_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:padding="6dp"
            android:background="@drawable/maxx_chip_container_bg">
            <TextView
                android:id="@+id/maxx_chip_all"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:gravity="center"
                android:background="@drawable/maxx_chip_bg"
                android:text="@string/maxx_filter_all"
                android:textColor="@color/maxx_chip_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:selected="true" />
            <TextView
                android:id="@+id/maxx_chip_personal"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:gravity="center"
                android:background="@drawable/maxx_chip_bg"
                android:text="@string/maxx_filter_personal"
                android:textColor="@color/maxx_chip_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:selected="false" />
            <TextView
                android:id="@+id/maxx_chip_business"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:gravity="center"
                android:background="@drawable/maxx_chip_bg"
                android:text="@string/maxx_filter_business"
                android:textColor="@color/maxx_chip_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:selected="false" />
            <TextView
                android:id="@+id/maxx_chip_otp"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:gravity="center"
                android:background="@drawable/maxx_chip_bg"
                android:text="@string/maxx_filter_otp"
                android:textColor="@color/maxx_chip_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:selected="false" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/conversation_list_first_item_extra_padding"
            android:paddingBottom="112dp"
            android:clipToPadding="false"
            android:listSelector="?android:attr/listSelector"
            android:dividerHeight="0px" />

        <include
            layout="@layout/list_empty_view"
            android:id="@+id/no_conversations_view"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/conversation_list_empty_text_bottom_margin" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            app:shapeAppearanceOverlay="@style/MaxxFabShapeAppearance"
            android:id="@+id/start_new_conversation_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="96dp"
            android:text=""
            android:contentDescription="@string/start_chat"
            android:forceDarkAllowed="false"
            android:textColor="@color/fab_fg_color"
            app:backgroundTint="@color/fab_color"
            app:icon="@drawable/ic_maxx_edit"
            app:iconTint="@color/fab_fg_color"
            app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior" />

        <!-- MaxxOS floating bottom navigation -->
        <LinearLayout
            android:id="@+id/maxx_bottom_nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/maxx_nav_bg"
            android:elevation="6dp">

            <LinearLayout
                android:id="@+id/maxx_nav_chats"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="20dp"
                android:background="@drawable/maxx_nav_selected_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/maxx_nav_chats">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_maxx_chat"
                    android:tint="@color/maxx_on_primary"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/maxx_nav_chats"
                    android:textColor="@color/maxx_on_primary"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>
        <ImageButton
            android:id="@+id/maxx_nav_contacts"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_maxx_people"
            android:tint="@color/maxx_icon"
            android:contentDescription="@string/maxx_nav_contacts" />
        <ImageButton
            android:id="@+id/maxx_nav_assistant"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_maxx_sparkle"
            android:tint="@color/maxx_icon"
            android:contentDescription="@string/maxx_nav_assistant"
            android:visibility="gone" />
        <ImageButton
            android:id="@+id/maxx_nav_settings"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_maxx_settings"
            android:tint="@color/maxx_icon"
            android:contentDescription="@string/maxx_nav_settings" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
